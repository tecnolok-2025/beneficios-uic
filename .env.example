DATABASE_URL=
ADMIN_PASSWORD=
SESSION_SECRET=
IP_HASH_SALT=
# v3.9.4 · Difusión de Beneficios
# Pruebas e internas pueden funcionar con SMTP configurado desde el panel.
# El padrón general debe permanecer BLOQUEADO durante la etapa piloto.
DIFFUSION_MASS_SEND_ENABLED=false
# Compatibilidad con v3.9.1: mantener también false si existiera en Render.
DIFFUSION_SEND_ENABLED=false
DIFFUSION_FROM_EMAIL=tesoreria@uic-campana.com.ar
DIFFUSION_FROM_NAME=Unión Industrial de Campana · Beneficios
DIFFUSION_APPROVAL_EMAIL=tesoreria@uic-campana.com.ar
# Se recomienda definir un secreto estable para cifrar la clave SMTP guardada en Neon.
DIFFUSION_MAIL_SECRET=
# Estos valores sirven como fallback; pueden configurarse desde Difusión > Correo emisor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
DIFFUSION_TEST_RECIPIENT=
